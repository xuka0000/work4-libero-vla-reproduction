  "abstract": [
    "This page summarizes the current work4 public VLA reproduction branch after the LIBERO Spatial saturation finding. All main rows use the harder LIBERO-10 suite with ten tasks, ten episodes per task, seed 7, and the same local evaluation harness unless marked otherwise.",
    "The page separates completed main metrics, smoke runs, cache preparation, and running states. Failed pre-health attempts are not reported as algorithm performance. The intent is to make the current comparison boundary visible before using the results in a thesis or paper."
  ],
  "method": {
    "title": "Protocol",
    "points": [
      "Benchmark suite: LIBERO-10.",
      "Comparison unit: ten tasks by ten episodes for each public baseline main row.",
      "Runtime boundary: same local work4 harness, RTX 5090 sm_120 repair when required, seed 7.",
      "Reporting rule: only rows with health, rollout, aggregate, and zero error episodes are treated as completed metric rows."
    ]
  },
