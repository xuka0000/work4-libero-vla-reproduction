  "abstract": [
    "This project page summarizes the work4 LIBERO-10 reproduction branch. It combines real robotic-arm rollout videos, task-level video coverage, and same-harness performance rows from public VLA and robot-policy candidates.",
    "The page deliberately separates video evidence from metric evidence. The current videos are OpenVLA-OFT failure rollouts, while several other algorithms have metric rows but no recorded MP4 clips. This prevents visual evidence from being overstated.",
    "LIBERO Spatial is retained as a runability sanity gate because strong public rows reached near-ceiling success. The main comparison shown here focuses on the harder LIBERO-10 protocol, where the same methods separate more clearly."
  ],
  "method": {
    "title": "Evaluation Protocol",
    "points": [
      "Simulator: LIBERO tabletop robotic manipulation.",
      "Primary suite: LIBERO-10, ten tasks with ten episodes per completed main row unless otherwise noted.",
      "Visual capture: real simulator MP4 exports from N263B and N264, captured at 20 FPS.",
      "Policy in available videos: OpenVLA-OFT with the cached moojink/openvla-7b-oft-finetuned-libero-10 checkpoint.",
      "Metric rows: same-harness local results, not official leaderboard submissions.",
      "Boundary: this is simulation evidence and does not claim hardware deployment or sim-to-real validation."
    ]
  },
